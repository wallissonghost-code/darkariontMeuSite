rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function hasAdminClaim() {
      return signedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'admin'
      );
    }

    // Compatibilidade com o modelo atual. Depois de configurar Custom Claims
    // para todos os administradores, esta função pode ser removida de isAdmin().
    function hasLegacyAdminRole() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role
          in ['admin', 'administrador', 'master'];
    }

    function isAdmin() {
      return hasAdminClaim() || hasLegacyAdminRole();
    }

    function validTheme(value) {
      return value in ['light', 'dark'];
    }

    function validOwnProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'nome',
          'telefone',
          'tema',
          'atualizadoEm'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 120
        && request.resource.data.telefone is string
        && request.resource.data.telefone.size() <= 30
        && validTheme(request.resource.data.tema);
    }

    match /usuarios/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'nome', 'email', 'telefone', 'role', 'vip', 'carimbos',
          'creditos', 'totalGasto', 'bonusBaseVip', 'bonusNivel',
          'bonusManual', 'tema', 'criadoEm', 'atualizadoEm'
        ])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2
        && request.resource.data.nome.size() <= 120
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.telefone is string
        && request.resource.data.telefone.size() <= 30
        && request.resource.data.role == 'cliente'
        && request.resource.data.vip == 0
        && request.resource.data.carimbos == 0
        && request.resource.data.creditos == 0
        && request.resource.data.totalGasto == 0
        && validTheme(request.resource.data.tema);

      allow update: if isAdmin() || (isOwner(uid) && validOwnProfileUpdate());
      allow delete: if isAdmin();
    }

    match /compras/{compraId} {
      allow get, list: if isAdmin() || (
        signedIn() && resource.data.clienteId == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
    }

    // Estoque interno, custos e margem: somente administradores.
    match /produtos/{produtoId} {
      allow read, write: if isAdmin();
    }

    match /estoque_movimentos/{movimentoId} {
      allow read, write: if isAdmin();
    }

    // Coleção antiga ainda referenciada por admin.js.
    match /produtosVitrine/{produtoId} {
      allow read, write: if isAdmin();
    }

    match /carteira_movimentos/{movimentoId} {
      allow get, list: if isAdmin() || (
        signedIn() && resource.data.clienteId == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
    }

    // Benefícios públicos necessários para o cartão do cliente.
    // Não coloque custos, fórmulas internas ou parâmetros secretos aqui.
    match /niveis/{nivelId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // A vitrine usa ofertas com tipo == 'produto'. Clientes apenas leem.
    match /ofertas/{ofertaId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    // Configurações operacionais nunca são expostas a clientes.
    match /configuracoes/{configId} {
      allow read, write: if isAdmin();
    }

    match /configuracoes_nivel/{configId} {
      allow read, write: if isAdmin();
    }

    match /notificacoes/{notificacaoId} {
      allow get, list: if isAdmin() || (
        signedIn() && resource.data.clienteId == request.auth.uid
      );
      allow create, update, delete: if isAdmin();
    }

    match /logs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Negação explícita para qualquer coleção nova não revisada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
