rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validProfilePhoto() {
      return request.resource != null
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/webp'];
    }

    match /usuarios/{uid}/perfil.jpg {
      allow read: if signedIn();
      allow create, update: if owns(uid) && validProfilePhoto();
      allow delete: if owns(uid);
    }

    match /usuarios/{uid}/perfil.webp {
      allow read: if signedIn();
      allow create, update: if owns(uid) && validProfilePhoto();
      allow delete: if owns(uid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
